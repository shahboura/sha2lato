# sha2lato compose-level config (interpolation only).
# Copy to compose/.env (gitignored). Runtime secrets live in secrets/*.env.
#
# Which agent image to run. Default: local build tag
# (docker compose up -d --build). Once CI publishes your image, point this
# at your registry, e.g.:
#   SHA2LATO_AGENT_IMAGE=ghcr.io/YOUR_USERNAME/sha2lato-agent:latest
#   SHA2LATO_AGENT_IMAGE=forgejo.example.com/YOUR_USERNAME/sha2lato-agent:latest
# Semver pins (from releases — see docs/versioning.md):
#   :1.4      latest patch of 1.4     (moves on patch releases)
#   :1        latest minor of 1       (moves on minor/patch releases)
#   :1.4.2    one frozen release      (never rebuilt)
SHA2LATO_AGENT_IMAGE=sha2lato-agent:local
