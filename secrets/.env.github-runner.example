# Optional: self-hosted GitHub Actions runner (disabled by default).
# Copy to secrets/.env.github-runner (gitignored), then enable:
#   docker compose --profile github-runner up -d
# See docs/github-runner.md for when you'd want this.

# Target repo (or ORG_URL for an org-wide runner)
REPO_URL=https://github.com/YOUR_USERNAME/sha2lato

# GitHub PAT (classic, repo scope) used to register the runner.
# Create at https://github.com/settings/tokens
ACCESS_TOKEN=
